!! irix.emwmrc: menus and bindings after IRIX 6.5's 4Dwm, for emwm.
!! Used by the irix resources (Emwm*configFile); copy to ~/.emwmrc and point
!! Emwm*configFile there to change it.

!! The Window menu, with 4Dwm's entries and accelerators. emwm has no
!! separate "quit the application", so Exit closes the window like Close.
Menu IrixWindowMenu
{
	Restore		_R	Alt<Key>F5	f.restore
	Move		_M	Alt<Key>F7	f.move
	Size		_S	Alt<Key>F8	f.resize
	Minimize	_n	Alt<Key>F9	f.minimize
	Maximize	_x	Alt<Key>F10	f.maximize
	Raise		_a	Alt<Key>F1	f.raise
	Lower		_L	Alt<Key>F3	f.lower
	no-label				f.separator
	Close		_C	Alt<Key>F4	f.kill
	Exit		_E	Alt<Key>F12	f.kill
}

!! The desktop background's menu (right button).
Menu IrixRootMenu
{
	"Desktop"		f.title
	"Open Unix Shell"	f.exec "xterm -ls -sb -title 'Unix Shell' &"
	"Toolchest"		f.exec "toolchest &"
	 no-label		f.separator
	"Next Desk"		f.next_workspace
	"Previous Desk"		f.prev_workspace
	"Pack Icons"		f.pack_icons
	 no-label		f.separator
	"Restart Window Manager..."	f.restart
}

Keys DefaultKeyBindings
{
	Shift<Key>Escape	window|icon		f.post_wmenu
	Alt<Key>space		window|icon		f.post_wmenu
	Alt<Key>Tab		root|icon|window	f.next_key
	Alt Shift<Key>Tab	root|icon|window	f.prev_key
	Alt<Key>Escape		root|icon|window	f.circle_down
	Alt Shift<Key>Escape	root|icon|window	f.circle_up
	Alt<Key>F6		window			f.next_key transient
	Alt Shift<Key>F6	window			f.prev_key transient
	Shift<Key>F10		icon			f.post_wmenu
}

!! Click to focus, as 4Dwm does by default.
Buttons ExplicitButtonBindings
{
	<Btn1Down>	frame|icon	f.raise
	<Btn3Down>	frame|icon	f.post_wmenu
	<Btn3Down>	root		f.menu	IrixRootMenu
	Alt<Btn1Down>	window|icon	f.lower
}
