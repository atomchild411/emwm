!! Emwm-irix.ad: emwm and the Toolchest made to look like IRIX 6.5's
!! Interactive Desktop. emwm-session merges this with xrdb; your own
!! ~/.Xdefaults is merged after it and wins.
!!
!! Colours were measured on IRIX 6.5.22's default scheme: unfocused frames
!! are neutral grey, the focused frame is a warm beige, menus light grey.

Emwm*configFile:		/usr/local/lib/X11/irix/irix.emwmrc
Emwm*windowMenu:		IrixWindowMenu
Emwm*buttonBindings:		ExplicitButtonBindings
Emwm*keyboardFocusPolicy:	explicit
Emwm*titleLeft:			True
Emwm*irixStyle:			True
Emwm*moveOpaque:		True
Emwm*resizeBorderWidth:		8
Emwm*frameBorderWidth:		8
Emwm*iconPlacement:		left bottom
Emwm*workspaceCount:		1

!! Bold oblique Helvetica (core X bitmap fonts, as on IRIX) for titles and
!! menus, medium oblique for icon labels. emwm takes its fonts as render
!! tables: variable (menus, dialogs), title and icon.
Emwm*renderTable:			variable
Emwm*renderTable.variable.fontType:	FONT_IS_FONT
Emwm*renderTable.variable.fontName:	-*-helvetica-bold-o-normal--14-*-*-*-p-*-iso8859-1
Emwm*title.renderTable:			title
Emwm*renderTable.title.fontType:	FONT_IS_FONT
Emwm*renderTable.title.fontName:	-*-helvetica-bold-o-normal--14-*-*-*-p-*-iso8859-1
Emwm*icon.renderTable:			icon
Emwm*renderTable.icon.fontType:		FONT_IS_FONT
Emwm*renderTable.icon.fontName:		-*-helvetica-medium-o-normal--12-*-*-*-p-*-iso8859-1

!! Unfocused frames and icons.
Emwm*client*background:		#aaaaaa
Emwm*client*foreground:		#000000
Emwm*client*topShadowColor:	#dcdcdc
Emwm*client*bottomShadowColor:	#737373
Emwm*icon*background:		#aaaaaa
Emwm*icon*foreground:		#000000
Emwm*icon*topShadowColor:	#dcdcdc
Emwm*icon*bottomShadowColor:	#737373

!! The focused frame.
Emwm*client*activeBackground:		#c5c1aa
Emwm*client*activeForeground:		#000000
Emwm*client*activeTopShadowColor:	#e9e7de
Emwm*client*activeBottomShadowColor:	#8b8777
Emwm*icon*activeBackground:		#c5c1aa
Emwm*icon*activeForeground:		#000000
Emwm*icon*activeTopShadowColor:		#e9e7de
Emwm*icon*activeBottomShadowColor:	#8b8777

!! Menus and the move/size feedback box.
Emwm*menu*background:		#d8d8d8
Emwm*menu*foreground:		#000000
Emwm*menu*topShadowColor:	#f4f4f4
Emwm*menu*bottomShadowColor:	#909090
Emwm*feedback*background:	#d8d8d8
Emwm*feedback*foreground:	#000000

!! The desktop: IRIX's teal and grey speckle.
Emwm*backdrop*image:		/usr/local/lib/X11/irix/speckle.xpm

!! The Toolchest.
Toolchest*fontList:		-*-helvetica-bold-o-normal--14-*-*-*-p-*-iso8859-1
Toolchest*background:		#d8d8d8
Toolchest*foreground:		#000000
Toolchest*topShadowColor:	#f1f1f1
Toolchest*bottomShadowColor:	#9d9d9d
Toolchest*title.background:	#aaaaaa

!! Unix Shell windows (xterm) like IRIX's winterm: navy, light grey text,
!! the scrollbar on the left, a green block cursor.
XTerm*background:		#000070
XTerm*foreground:		#e6e6e6
XTerm*cursorColor:		#00ff00
XTerm*scrollBar:		True
XTerm*rightScrollBar:		False
XTerm*saveLines:		2000
XTerm*font:			7x14
XTerm*scrollbar.background:	#bdbdbd
XTerm*scrollbar.foreground:	#e0e0e0

!! Menus as IRIS IM draws them: a black outline and thin bevels, the armed
!! entry near-white with a black bottom and right edge, and stroked
!! mnemonics. enableIrixStyle needs Motif built with it (atomchild411/motif,
!! branch irix); the colour trick below (black "top" shadow, which a sunken
!! armed entry draws bottom and right) works with any Motif.
Emwm*enableIrixStyle:		True
Emwm*enableThinThickness:	True
Emwm*enableEtchedInMenu:	True
Toolchest*enableIrixStyle:	True
Toolchest*enableThinThickness:	True
Toolchest*enableEtchedInMenu:	True
Emwm*menu*XmRowColumn.shadowThickness:		2
Toolchest*XmRowColumn.shadowThickness:		2
Toolchest*XmRowColumn.background:		#d8d8d8
Toolchest*XmRowColumn.topShadowColor:		#f4f4f4
Toolchest*XmRowColumn.bottomShadowColor:	#909090
Emwm*menu*armColor:				#f4f4f4
Emwm*menu*XmPushButtonGadget.topShadowColor:	#000000
Emwm*menu*XmPushButtonGadget.bottomShadowColor:	#f4f4f4
Emwm*menu*XmCascadeButtonGadget.topShadowColor:	#000000
Emwm*menu*XmCascadeButtonGadget.bottomShadowColor:	#f4f4f4
Emwm*menu*XmSeparatorGadget.topShadowColor:	#f4f4f4
Emwm*menu*XmSeparatorGadget.bottomShadowColor:	#909090
Toolchest*XmRowColumn*armColor:			#f4f4f4
Toolchest*XmRowColumn*XmPushButton.topShadowColor:	#000000
Toolchest*XmRowColumn*XmPushButton.bottomShadowColor:	#f4f4f4
Toolchest*XmRowColumn*XmCascadeButton.topShadowColor:	#000000
Toolchest*XmRowColumn*XmCascadeButton.bottomShadowColor:	#f4f4f4
Toolchest*XmRowColumn*XmSeparator.topShadowColor:	#f4f4f4
Toolchest*XmRowColumn*XmSeparator.bottomShadowColor:	#909090

!! Dialog push buttons as IRIS IM draws them (with enableIrixStyle): a dark
!! outline around a two-tone bevel, a face darker than the dialog, and a
!! return glyph on the default button.
Emwm*feedback*XmPushButtonGadget.shadowThickness:	4
Emwm*feedback*XmPushButtonGadget.background:	#bdbdbd
Emwm*feedback*XmPushButtonGadget.marginWidth:	10
Emwm*feedback*XmPushButtonGadget.marginHeight:	4
Emwm*feedback*XmMessageBox*highlightThickness:	0
!! Dialogs set their text upright, unlike menus.
Emwm*feedback*XmMessageBox*renderTable:	dialog
Emwm*dialog.fontType:			FONT_IS_FONT
Emwm*dialog.fontName:			-*-helvetica-medium-r-normal--14-*-*-*-p-*-iso8859-1
